{
  "name": "logw",
  "main": "./dist/logw.js",
  "type": "module",
  "version": "0.0.2",
  "scripts": {
    "build-file": "bun build ./src/providers/file.ts --target node --outdir ./dist",
    "build-logw": "bun build ./src/logw.ts --outdir ./dist --env=disable",
    "build": "bun run build-logw && bun run build-file && bun run types",
    "types": "tsc --project tsconfig.types.json",
    "test": "bun test"
  },
  "files": [
    "./dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/logw.js",
      "types": "./dist/types/logw.d.ts"
    },
    "./file": {
      "import": "./dist/file.js",
      "types": "./dist/types/providers/file.d.ts"
    }
  },
  "devDependencies": {
    "bun-types": "^1.3.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "dapes": "^0.0.58"
  }
}
